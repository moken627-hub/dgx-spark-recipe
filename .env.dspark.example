# ============================================================
# 5ac AI Lab — DeepSeek V4 Flash 0731 on 2x DGX Spark (GB10)
# Env template — copy to .env.dspark and edit per-cluster
#   cp .env.dspark.example .env.dspark
# Reference: ghcr.io/anemll/dspark-vllm-gx10:0.1.1 (Anemll)
# Source recipe: MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
# ============================================================

# ---- Image / checkpoint ----
DSPARK_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Official 0731 checkpoint commit (ABLITERATED=0)
CHECKPOINT_COMMIT=9e165c30

# ---- TP=2 cluster addressing (edit per-cluster) ----
# Hostname/IP of the worker node (start this one FIRST)
WORKER_HOST=10.0.0.2
# Hostname/IP of the head node (the one that serves :8888)
MASTER_ADDR=10.0.0.1
# RoCEv2 IB HCA for the QSFP56 200G link (NVIDIA/Mellanox)
NCCL_IB_HCA=mlx5_0
# Ethernet iface for out-of-band / control plane
NCCL_SOCKET_IFNAME=eth0
# This node's IP as seen by the peer (VLLM host ip)
VLLM_HOST_IP=10.0.0.1
# Where HF checkpoints are cached on both hosts
HF_CACHE=/root/.cache/huggingface

# ---- Model serving knobs (default profile, 1M context) ----
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
MTP_NUM_TOKENS=5
DEFAULT_THINKING=max
VLLM_USE_BREAKABLE_CUDAGRAPH=0
# cudagraph capture = MAX_NUM_SEQS x (MTP_NUM_TOKENS+1) = 36
MAX_CUDAGRAPH_CAPTURE_SIZE=36

# ---- Hotfix / behaviour toggles ----
# #79 spin-wait P-core: set to 1 to DISABLE the hotfix (default hotfix ON)
# DSPARK_SKIP_SPIN_WAIT_HOTFIX=1
# #52 assistant-final (required for agent harness): opt-in
# DSPARK_ENABLE_ASSISTANT_FINAL_HOTFIX=1
# Responses API stateful continuation (4-gate live verifier)
# VLLM_ENABLE_RESPONSES_API_STORE=1
# Optional VL sidecar -> Qwen3-VL :8889 + MCP
# ENABLE_VL_SIDECAR=1

# ---- Ops safety ----
# earlyoom MUST be disabled on both hosts or it kills vLLM under deep-context load
#   systemctl stop earlyoom && systemctl disable earlyoom
